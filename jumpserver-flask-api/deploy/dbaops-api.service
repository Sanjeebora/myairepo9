[Unit]
Description=DBA ops API (Flask) - runs /dba/bin scripts on DB servers via ccps
After=network-online.target sshd.service
Wants=network-online.target

[Service]
Type=simple
User=dbaops
Group=dbaops
WorkingDirectory=/opt/dbaops-api
EnvironmentFile=/etc/dbaops-api/dbaops.env
ExecStart=/opt/dbaops-api/venv/bin/gunicorn \
    --workers 1 --worker-class gthread --threads 4 \
    --bind 127.0.0.1:8080 --timeout 660 --graceful-timeout 30 \
    --access-logfile - --error-logfile - \
    wsgi:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/dbaops-api

[Install]
WantedBy=multi-user.target
