# Copy to /etc/dbaops-api/dbaops.env, then: chown root:dbaops, chmod 640.
# Generate each value with: /opt/dbaops-api/venv/bin/python -m dbaops_api gen-secret

# Signs session tokens. Changing it immediately invalidates every issued token.
DBAOPS_SECRET_KEY=change-me-to-a-48-char-random-value-from-gen-secret

# Long-lived key the agent harness sends as X-API-Key to POST /session for a fresh token.
# Leave empty to disable POST /session and mint tokens only on the jump server (dbaops_api token).
DBAOPS_API_KEY=change-me-too

DBAOPS_CONFIG=/opt/dbaops-api/config.json

# Only needed if requests send "analyze": true
# LLM_API_KEY=
