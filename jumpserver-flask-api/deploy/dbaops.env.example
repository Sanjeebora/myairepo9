# Copy to /etc/dbaops-api/dbaops.env, then: chown root:dbaops, chmod 640.
# People log in with their own jump server username and password; nothing here is per person.

DBAOPS_CONFIG=/opt/dbaops-api/config.json

# High-entropy gateway credential required in the X-Token header on every non-health request.
# Generate on the jump host (for example: openssl rand -hex 32), and inject the same value into
# the harness secret store. Never put the generated value in source control or command arguments.
DBAOPS_XTOKEN=

# Passphrase of ~oracle/.ssh/cp993, which ssh-add (ccps) asks for.
# Set the real value only in /etc/dbaops-api/dbaops.env on the jump server, never in git.
CCPS_PASSPHRASE=

# Only needed if requests send "analyze": true
# LLM_API_KEY=
