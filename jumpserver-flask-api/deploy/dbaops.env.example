# Copy to /etc/dbaops-api/dbaops.env, then: chown root:dbaops, chmod 640.
DBAOPS_CONFIG=/etc/dbaops-api/config.json

# Generate with: python -c 'import os,binascii; print(binascii.hexlify(os.urandom(32)).decode())'
DBAOPS_API_TOKEN=

# Secret entered into interactive ccps after becoming oracle.
# Set real values only in /etc/dbaops-api/dbaops.env, never in git or command arguments.
CCPS_SECRET=
