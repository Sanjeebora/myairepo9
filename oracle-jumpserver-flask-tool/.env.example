# Copy to .env (install.bat does this) and edit. Never put your own password here:
# the tool asks for it at startup or on the login page.

# Jump server
JT_JUMP_HOST=pretzel.int.thomsonreuters.com
JT_JUMP_PORT=22
# tofu = remember the key on first login, fail if it changes (default)
# strict = only keys already in known_hosts; insecure = never check (testing only)
JT_HOST_KEY_POLICY=tofu
# JT_KNOWN_HOSTS=C:\Users\me\.ssh\known_hosts

# Local API. Keep 127.0.0.1 unless you have read the README security section.
JT_BIND_HOST=127.0.0.1
JT_BIND_PORT=5055
# Fixed API key for your agent. Leave empty to get a new random key each start.
JT_API_KEY=

# Steps after login
JT_BECOME_COMMAND=sudo su - oracle
JT_BECOME_USER=oracle
JT_CCPS_COMMAND=ccps
# Default is bake6Pies. Set this only if the ccps password changes.
# JT_CCPS_PASSWORD=
# JT_CCPS_REQUIRE_PROMPT=false
# JT_CCPS_IGNORE_EXIT_CODE=false

# Options for `ssh <host> <script>` run as oracle on the jump server
# JT_TARGET_SSH_OPTIONS=-n -T -o BatchMode=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR
# Only allow matching target hosts (Python regex, full match, case-insensitive)
# JT_ALLOWED_HOST_REGEX=.*\.int\.thomsonreuters\.com

# Timeouts in seconds
# JT_SESSION_IDLE_TIMEOUT=1800
# JT_SESSION_MAX_AGE=28800
# JT_COMMAND_TIMEOUT=900
# JT_MAX_COMMAND_TIMEOUT=3600
# JT_LOGIN_TIMEOUT=90
# JT_MAX_HOSTS=20

# Prompt matching (Python regexes); change only if your prompts differ
# JT_SUDO_PROMPT_REGEX=(?im)(\[sudo\] password for [^:\r\n]*:|^password( for [^:\r\n]*)?:)\s*$
# JT_CCPS_PROMPT_REGEX=(?i)(password|passphrase)[^\r\n]*:\s*$
# JT_SHELL_PROMPT_REGEX=[$#>%]\s*$
# JT_AUTH_FAILURE_REGEX=(?i)(sorry, try again|incorrect password|authentication failure|bad passphrase)
